DROP DATABASE IF EXISTS db_CarrodePalha;
CREATE DATABASE db_CarrodePalha;
USE db_CarrodePalha;

CREATE TABLE tb_sedes (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
nome VARCHAR(50) NOT NULL,
endereco VARCHAR(80) NOT NULL,
telefone VARCHAR(20) NOT NULL,
nomeGerente VARCHAR(50) NOT NULL,
multa DECIMAL(8,2) NOT NULL
);

CREATE TABLE tb_classesCarro (
id INT NOT NULL AUTO_INCREMENT,
nome VARCHAR(20) NOT NULL,
valorDiaria DECIMAL(8,2) NOT NULL,
PRIMARY KEY (id)
);

CREATE TABLE tb_clientes (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
nome VARCHAR(50) NOT NULL,
cpf VARCHAR(14) NOT NULL,
cnh VARCHAR(20) NOT NULL,
validadeCnh DATE NOT NULL,
categoriaCnh VARCHAR(3) NOT NULL
);

CREATE TABLE tb_carros (
id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
placa VARCHAR(10) NOT NULL,
modelo VARCHAR(40) NOT NULL,
ano VARCHAR(9) NOT NULL,
cor VARCHAR(20) NOT NULL,
quilometragem DECIMAL(10,2) NOT NULL,
descricao VARCHAR(100) NOT NULL,
situacao VARCHAR(30) NOT NULL,
origemCarro INT NOT NULL,
localizacaoCarro INT,
classeCarro INT NOT NULL,
FOREIGN KEY (origemCarro) REFERENCES tb_sedes (id),
FOREIGN KEY (localizacaoCarro) REFERENCES tb_sedes (id),
FOREIGN KEY (classeCarro) REFERENCES tb_classesCarro (id)
);

CREATE TABLE tb_reservas (
numero INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
diarias INT NOT NULL,
dataLocacao DATE NOT NULL,
dataRetorno DATE,
quilometrosRodados DECIMAL(10,2),
multa DECIMAL(8,2),
situacao VARCHAR(15) NOT NULL,
total DECIMAL(10,2),
carro_reserva INT NOT NULL,
cliente_reserva INT NOT NULL,
sedeLocacao INT NOT NULL,
sedeDevolucao INT NOT NULL,
FOREIGN KEY (carro_reserva) REFERENCES tb_carros (id),
FOREIGN KEY (cliente_reserva) REFERENCES tb_clientes (id),
FOREIGN KEY (sedeLocacao) REFERENCES tb_sedes (id),
FOREIGN KEY (sedeDevolucao) REFERENCES tb_sedes (id)
);
SHOW TABLES;



