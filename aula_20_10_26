tabela empregados

1)Liste a media salarial dos empregados

SELECT AVG (salario) AS (media_salarial)
FROM empregados;

2)liste o total de empregados

SELECT COUNT (*) AS  (total_empregado)
FROM empregados;

3)liste o maior salario 

SELECT MAX (salario) AS (salario_maximo)
FROM empregados;

4)Liste o total da folha de pagamento dos empregados

SELECT SUM (salario) AS (folha_de_pagamento)
FROM empregado;


Retorna o total de empregados em cada cidade 

GROUP BY 

SELECT cidade, count(*) AS total_de_empregados_por_cidade
FROM empregado
GROUP BY cidade;

5)Qual a media salarial dos DBAs por cidades?

SELECT cidade,AVG (salario) AS media_salario
FROM empregados
WHERE nome_cargo = "DBA"
GROUP BY cidade;

