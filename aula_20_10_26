6) Liste os codigos dos cargos que possuem a soma dos salarios maior que 100000

SELECT cod_cargo,SUM(salario)
FROM empregados
GROUP BY codigo_cargo
HAVING SUM(salario) > 100000;

Listar o nome dos empregados com o nome do cargo 

LISTAR DE DUAS TABELAS INFORMAÇOES

SELECT empregado.nome, cargo.descriçao
FROM  empregado, cargo 
WHERE empregado.cod_cargo = cargo.cod_cargo


SELECT empregado.nome, cargo.descriçao
FROM  empregado INNER JOIN cargo 
ON empregado.cod_cargo = cargo.cod_cargo























